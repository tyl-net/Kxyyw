<%- include('partials/header') %>

<div class="container">
  <div class="breadcrumb"><a href="/">首页</a> / <a href="/articles">文章列表</a> / <%= a.title %></div>
  <article class="article-detail">
    <span class="article-cat"><%= a.category %></span>
    <h1 style="margin-top:12px"><%= a.title %></h1>
    <div class="meta">
      <span>作者：<%= a.author %></span>
      <span><%= a.created_at %></span>
      <span><%= a.view_count + 1 %> 次阅读</span>
    </div>
    <div class="article-content"><%- a.content %></div>
  </article>
  <div style="text-align:center;padding-bottom:24px"><a class="btn ghost" href="/articles">← 返回文章列表</a></div>
</div>

<%- include('partials/footer') %>
