<%- include('partials/header') %>

<section class="page-intro-section">
  <div class="container">
    <div class="page-intro">
      <h1 class="page-intro-title">赛事报名</h1>
      <p class="page-intro-desc">发现精彩赛事，参与竞技挑战</p>
    </div>
  </div>
</section>

<div class="container" style="padding-top:26px">
  <div class="filter-tabs" style="margin-bottom:22px">
    <a class="filter-btn <%= status === 'all' ? 'active' : '' %>" href="/competitions">全部赛事</a>
    <% [1,2,3,4].forEach(function(s){ %>
      <a class="filter-btn <%= String(status) === String(s) ? 'active' : '' %>" href="/competitions?status=<%= s %>"><%= COMP_STATUS[s].label %></a>
    <% }); %>
  </div>

  <% if (!comps.length) { %>
    <div class="empty"><div class="ico">📅</div><p>暂无该状态的赛事。</p></div>
  <% } else { %>
    <div class="competition-grid">
      <% comps.forEach(function(c){ %>
        <div class="competition-card">
          <div class="competition-cover">
            <img src="<%= c.cover %>" alt="<%= esc(c.title) %>" loading="lazy">
            <span class="type-badge"><%= c.type === 'work' ? '作品类' : '非作品类' %></span>
            <span class="status-badge <%= c.statusInfo.cls %>"><%= c.statusInfo.label %></span>
          </div>
          <div class="competition-content">
            <h3 class="competition-title"><%= c.title %></h3>
            <div class="competition-meta"><span>◆ <%= c.competition_level %></span><span><%= c.subtitle %></span></div>
            <div class="competition-time">
              <div><span class="time-label">报名时间</span><%= c.reg_start || '待定' %> ~ <%= c.reg_end || '待定' %></div>
            </div>
            <div class="competition-foot">
              <span class="apply-count"><%= c.applicants %> 人已报名</span>
              <a class="btn sm" href="/competition/<%= c.id %>">查看详情</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
