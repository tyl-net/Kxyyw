<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>管理后台登录 - <%= SITE.name %></title>
<link rel="icon" href="/img/logo.svg">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div class="admin-login">
  <div class="auth-card">
    <h1>管理后台</h1>
    <p class="auth-sub"><%= SITE.name %> · <%= SITE.subtitle %></p>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <div class="field"><label>管理员账号</label><input type="text" name="username" placeholder="请输入账号" required autofocus></div>
      <div class="field"><label>密码</label><input type="password" name="password" placeholder="请输入密码" required></div>
      <button class="btn btn-block" type="submit">登 录</button>
    </form>
    <div class="alert ok" style="margin-top:18px;font-size:12.5px">默认账号：admin / Admin@123</div>
    <div class="auth-foot"><a href="/">← 返回前台</a></div>
  </div>
</div>
</body>
</html>
