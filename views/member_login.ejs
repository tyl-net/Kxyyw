<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>会员登录</h1>
    <p class="auth-sub">欢迎回来！</p>
    <% if (error) { %><div class="alert err"><%= error %></div><% } %>
    <% if (query.registered) { %><div class="alert ok">注册成功，请登录。</div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="redirect" value="<%= redirect %>">
      <div class="field">
        <label>用户名 / 学号 / 工号</label>
        <input type="text" name="account" placeholder="请输入账号" required autofocus>
      </div>
      <div class="field">
        <label>密码</label>
        <input type="password" name="password" placeholder="请输入密码" required>
      </div>
      <button class="btn btn-block" type="submit">登 录</button>
    </form>
    <div class="divider">或</div>
    <a class="btn-qq-block" href="/qq_login"><span class="qq-dot" style="background:#12b7f5;color:#fff">Q</span> 使用 QQ 账号登录</a>
    <div class="auth-foot">
      还没有账号？<a href="/register">立即注册</a>　|　<a href="/">返回首页</a>
    </div>
    <div class="alert ok" style="margin-top:18px;font-size:12.5px">演示账号：demo / Demo@1234</div>
  </div>
</div>

<%- include('partials/footer') %>
