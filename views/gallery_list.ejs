<%- include('partials/header') %>

<section class="page-intro-section">
  <div class="container">
    <div class="page-intro">
      <h1 class="page-intro-title">赛事风采</h1>
      <p class="page-intro-desc">记录比赛精彩瞬间，展示竞赛活动风采，回顾每一次难忘的赛事经历</p>
    </div>
  </div>
</section>

<div class="container">
  <% if (!galleries.length) { %>
    <div class="empty" style="margin:30px 0"><div class="ico">🖼️</div><p>暂无图集。</p></div>
  <% } else { %>
    <div class="gallery-grid">
      <% galleries.forEach(function(g){ %>
        <a class="gallery-card" href="/gallery/<%= g.id %>">
          <div class="gallery-cover">
            <img src="<%= g.cover %>" alt="<%= esc(g.title) %>" loading="lazy">
            <span class="gallery-badge"><%= g.count %> 张</span>
          </div>
          <div class="gallery-info">
            <h3 class="gallery-title"><%= g.title %></h3>
            <p class="gallery-desc"><%= g.description %></p>
            <div class="gallery-date"><%= g.event_date %></div>
          </div>
        </a>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
